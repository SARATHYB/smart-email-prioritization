# ===============================================================
# Smart Personalized Email Prioritization System - Configuration
# ===============================================================

# Ingestion Source: "mock" (for instant portfolio demo) or "gmail" (live Gmail OAuth)
INGESTION_SOURCE=mock

# Target email used for mock generation & simulation
MOCK_TARGET_EMAIL=sarathybhas@gmail.com

# Gmail API Configuration (only required if INGESTION_SOURCE=gmail)
GMAIL_CREDENTIALS_PATH=ingestion/credentials.json
GMAIL_TOKEN_PATH=ingestion/token.json

# Storage
DATABASE_PATH=storage/emails.db

# API Server Settings
API_HOST=127.0.0.1
API_PORT=8000

# Default TUDS Parameters
# Priority_Score(t) = (R * I) * (1 + alpha * e^(-lambda * t))
DEFAULT_ALPHA=1.5
DEFAULT_USER_WEIGHT=0.8
